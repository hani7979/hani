import sys
import time
import random

# ANSI escape sequences for colors
COLORS = [
    "\033[91m",  # Red
    "\033[92m",  # Green
    "\033[93m",  # Yellow
    "\033[94m",  # Blue
    "\033[95m",  # Magenta
    "\033[96m",  # Cyan
    "\033[97m",  # White
]

RESET_COLOR = "\033[0m"  # Reset color to default

# 애니메이션 효과를 위한 텍스트 이동 함수
def moving_text_animation(text, width=40, speed=0.1):
    text = "  " + text + "  "  # 텍스트 양옆에 공백 추가하여 움직임을 부드럽게 만듬
    while True:
        for i in range(len(text) - width):
            sys.stdout.write(f"\r{random.choice(COLORS)}{text[i:i+width]}{RESET_COLOR}")
            sys.stdout.flush()
            time.sleep(speed)

# 실행할 텍스트
text = "간지나는 텍스트가 움직입니다!"

# 애니메이션 실행
moving_text_animation(text, width=40, speed=0.1)
