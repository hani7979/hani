import time
import sys

# 멋진 텍스트 애니메이션을 출력하는 함수
def print_animation(text):
    for char in text:
        sys.stdout.write(char)
        sys.stdout.flush()
        time.sleep(0.1)  # 타이핑 효과를 주기 위해 딜레이 추가
    print()  # 텍스트 끝에 줄 바꿈 추가

