import time
import sys

def countdown_timer(seconds):
    for i in range(seconds, 0, -1):
        sys.stdout.write(f"\r{str(i)} seconds remaining...")  # \r을 사용하여 커서를 맨 앞으로 이동
        sys.stdout.flush()
        time.sleep(1)
    sys.stdout.write("\rTime's up!               \n")  # 타이머 종료 후 메시지

# 타이머를 10초로 설정
countdown_timer(10)
